<dashboard version="1.1" theme="dark">
  <label>Provenex Overview</label>
  <description>
    SOC view over Provenex provenance receipts. Top row is operational
    posture (mode + critical alarms); middle row is policy-decision
    activity; bottom row is the drift detector and the advisory-mode
    rollout signal.
  </description>

  <row>
    <panel>
      <title>Operating mode (24h)</title>
      <chart>
        <search>
          <query>| savedsearch provenex_receipts_by_mode_24h</query>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.legend.placement">right</option>
      </chart>
    </panel>
    <panel>
      <title>TAMPERED alarms (1h)</title>
      <table>
        <search>
          <query>| savedsearch provenex_tampered_alarms</query>
        </search>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Denied tool calls (24h)</title>
      <table>
        <search>
          <query>| savedsearch provenex_denied_tool_calls_24h</query>
        </search>
      </table>
    </panel>
    <panel>
      <title>Top callers by deny rate (24h)</title>
      <table>
        <search>
          <query>| savedsearch provenex_top_callers_by_denial_rate_24h</query>
        </search>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>UNVERIFIED chunks by jurisdiction (24h)</title>
      <chart>
        <search>
          <query>| savedsearch provenex_unverified_chunks_by_jurisdiction</query>
        </search>
        <option name="charting.chart">column</option>
      </chart>
    </panel>
    <panel>
      <title>Advisory-mode "would have blocked" (24h)</title>
      <table>
        <search>
          <query>| savedsearch provenex_advisory_would_have_blocked_24h</query>
        </search>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Drift detector alerts (7d)</title>
      <table>
        <search>
          <query>| savedsearch provenex_drift_alerts</query>
        </search>
      </table>
    </panel>
  </row>
</dashboard>
